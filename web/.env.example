DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hatenpity?schema=public"
DATABASE_SCHEMA="public"
DATABASE_POOL_MAX="10"
DATABASE_IDLE_TIMEOUT_MS="30000"
DATABASE_SSL="false"
DATABASE_SSL_REJECT_UNAUTHORIZED="true"

AUTH_SECRET="change-me-to-a-random-string"

STORAGE_DRIVER="local"
MAX_VIDEO_BYTES="104857600"

# S3 mode (used when STORAGE_DRIVER="s3")
S3_REGION="auto"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_KEY_PREFIX="videos"
S3_FORCE_PATH_STYLE="false"
S3_SIGNED_URL_TTL_SECONDS="900"

